# Optional defaults for the web application. Copy to .env and enter keys privately.
# Populated .env files are ignored by Git; never commit credentials.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
# Optional fallback for primary Gemini quota/temporary errors:
LLM_FALLBACK_MODEL=gemini-flash-lite-latest
# Alternative providers selected through Model settings or LLM_PROVIDER:
GROQ_API_KEY=
XAI_API_KEY=
# Hosted access/signing/storage secrets belong in the Vercel environment.
# See pocket-fde/web/DEPLOYMENT.md; do not copy deployment credentials here.
