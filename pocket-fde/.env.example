# Original CLI provider: claude_cli | ollama | mock
LLM_PROVIDER=claude_cli
LLM_MODEL=sonnet
# Optional local Tier-1 model (used only if TIER_MODE != frontier_only and ollama is running)
LOCAL_MODEL=gemma3:1b
# local_only | hybrid | frontier_only
TIER_MODE=hybrid
# Budget guard
MAX_STEPS=6
MAX_TOKENS_PER_RUN=12000

# Web app: groq | gemini | xai | claude_cli
# Or connect a provider in the UI (local session memory; encrypted cookies when hosted).
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
